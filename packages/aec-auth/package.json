{
  "name": "aec-auth",
  "version": "0.1.1",
  "description": "The token layer for Autodesk Platform Services (APS / ACC). One TokenSource contract, pluggable backends (Vercel Connect, Better Auth, self-hosted vault), a typed client, and a single-flight refresh that survives APS's single-use rotating refresh tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./aps": {
      "types": "./dist/aps.d.mts",
      "default": "./dist/aps.mjs"
    },
    "./vault": {
      "types": "./dist/vault.d.mts",
      "default": "./dist/vault.mjs"
    },
    "./vault/upstash": {
      "types": "./dist/vault-upstash.d.mts",
      "default": "./dist/vault-upstash.mjs"
    },
    "./connect": {
      "types": "./dist/connect.d.mts",
      "default": "./dist/connect.mjs"
    },
    "./betterauth": {
      "types": "./dist/betterauth.d.mts",
      "default": "./dist/betterauth.mjs"
    },
    "./mock": {
      "types": "./dist/mock.d.mts",
      "default": "./dist/mock.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@upstash/redis": "*",
    "@vercel/connect": "*",
    "better-auth": "*"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@vercel/connect": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "keywords": [
    "aec",
    "autodesk",
    "aps",
    "forge",
    "oauth",
    "auth",
    "tokens",
    "construction",
    "bim",
    "nextjs",
    "vercel-connect"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrestrepoj10/aec-auth",
    "directory": "packages/aec-auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@aps_sdk/autodesk-sdkmanager": "^1.0.1",
    "@aps_sdk/model-derivative": "^1.2.1",
    "@types/node": "^26.2.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/connect": "^0.7.0",
    "better-auth": "^1.6.27",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
