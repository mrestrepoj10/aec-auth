{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["APS_BASE_URL", "CALLBACK_URL", "PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "APS_CLIENT_ID",
        "APS_CLIENT_SECRET",
        "APS_CONNECTOR",
        "APS_EMULATOR_URL",
        "VERCEL_OIDC_TOKEN"
      ]
    },
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
