{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "APS_CLIENT_ID",
    "APS_CLIENT_SECRET",
    "APS_CONNECTOR",
    "VERCEL_OIDC_TOKEN",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
